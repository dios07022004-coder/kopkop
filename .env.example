# ─────────────────────────────────────────────────────────────
# Деньги под контролें — переменные окружения
# Скопируйте в .env.local (локально) и в настройки хостинга (прод)
# ─────────────────────────────────────────────────────────────

# Публичный адрес сайта (для return-url оплаты, webhook, OAuth-редиректов)
# Локально: http://localhost:3000 · Прод: https://kopkop.ru
NEXT_PUBLIC_SITE_URL=https://kopkop.ru

# ── YooKassa (платежи) — https://yookassa.ru/my ──
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# ── Supabase (база данных + авторизация) — https://supabase.com/dashboard ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Админ-панель (/admin) — кто видит оплаты и пользователей ──
# Email(ы) администраторов через запятую. Этот человек входит обычным
# способом (Google/почта), и по совпадению email получает доступ к /admin.
ADMIN_EMAILS=dios07022004@gmail.com

# ── Resend (письма после оплаты) — https://resend.com ──
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Деньги под контролем <noreply@kopkop.ru>

# ── Выдача продукта ──
PRODUCT_GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/.../edit?usp=sharing
PRODUCT_PRICE=399

# ── Локальный dev-вход (ТОЛЬКО для разработки) ──
# Встроенного тест-аккаунта нет. Чтобы включить dev-вход локально,
# задайте ВСЕ три переменные. В проде НЕ задавайте их.
# DEV_AUTH_BYPASS=true
# DEV_AUTH_EMAIL=
# DEV_AUTH_PASSWORD=
# DEV_AUTH_TOKEN=
